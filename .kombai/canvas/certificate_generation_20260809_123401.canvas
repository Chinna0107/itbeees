      },
      "html": "<div class=\"min-h-screen bg-slate-200 flex items-center justify-center p-8 font-['Montserrat']\" data-kid=\"1\" data-name=\"page layout container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap');\n    \n    .certificate-container {\n      width: 1280px;\n      height: 900px;\n      background: white;\n      position: relative;\n      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);\n      border: 6px double #C5A059;\n      outline: 1px solid #C5A059;\n      outline-offset: -12px;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .header-navy {\n      background: linear-gradient(180deg, #001F5B 0%, #003087 100%);\n      position: relative;\n      height: 380px;\n      width: 100%;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      padding-top: 40px;\n      border-bottom-left-radius: 50% 12%;\n      border-bottom-right-radius: 50% 12%;\n    }\n\n    .dot-pattern {\n      position: absolute;\n      inset: 0;\n      background-image: radial-gradient(rgba(255, 255, 255, 0.1) 0.5px, transparent 0.5px);\n      background-size: 15px 15px;\n      pointer-events: none;\n    }\n\n    .title-band {\n      background: #001A4D;\n      color: white;\n      padding: 16px 100px;\n      border-radius: 9999px;\n      border: 2px solid rgba(255, 255, 255, 0.15);\n      position: absolute;\n      bottom: -35px;\n      box-shadow: 0 12px 30px -5px rgba(0, 0, 0, 0.4);\n      z-index: 20;\n    }\n\n    .underlined-field {\n      border-bottom: 1.5px solid #001F5B;\n      display: inline-block;\n      width: 580px;\n      margin-top: 10px;\n      height: 2px;\n    }\n\n    .chart-decoration {\n      position: absolute;\n      top: 38%;\n      opacity: 0.08;\n      pointer-events: none;\n      color: #001F5B;\n    }\n\n    .seal-container {\n      position: absolute;\n      bottom: 60px;\n      right: 40px;\n      z-index: 50;\n    }\n\n    .ribbon {\n      width: 45px;\n      height: 120px;\n      background: #001F5B;\n      position: absolute;\n      top: 60px;\n      z-index: -1;\n      clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 50% 88%, 0% 100%);\n      border: 1px solid rgba(255, 255, 255, 0.1);\n    }\n\n    .card-shadow {\n      box-shadow: 0 4px 20px rgba(0, 31, 91, 0.08);\n    }\n    </style>\n    <div class=\"certificate-container\" data-kid=\"1-1\" data-name=\"certificate card container\" id=\"certificate\">\n        <!-- Top Navy Section -->\n        <div class=\"header-navy\" data-kid=\"1-1-1\" data-name=\"header navy section\">\n            <div class=\"dot-pattern\" data-kid=\"1-1-1-1\" data-name=\"background dot pattern\">\n            </div>\n            <!-- Logo/Icon -->\n            <div class=\"mb-4 relative\" data-kid=\"1-1-1-2\" data-name=\"logo icon wrapper\">\n                <div class=\"w-24 h-24 rounded-full border border-white/20 flex items-center justify-center p-2 bg-white/5 backdrop-blur-xs\" data-kid=\"1-1-1-2-1\" data-name=\"logo circular frame\">\n                    <svg class=\"w-full h-full\" data-kid=\"1-1-1-2-1-1\" data-name=\"logo vector icon\" viewbox=\"0 0 100 100\">\n                        <defs>\n                            <lineargradient id=\"iconGrad\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\">\n                                <stop offset=\"0%\" style=\"stop-color:white;stop-opacity:0.8\">\n                                </stop>\n                                <stop offset=\"100%\" style=\"stop-color:white;stop-opacity:0.3\">\n                                </stop>\n                            </lineargradient>\n                        </defs>\n                        <circle cx=\"50\" cy=\"50\" fill=\"none\" r=\"42\" stroke=\"url(#iconGrad)\" stroke-dasharray=\"1 3\" stroke-width=\"1\">\n                        </circle>\n                        <circle cx=\"50\" cy=\"50\" fill=\"none\" r=\"32\" stroke=\"white\" stroke-width=\"0.8\">\n                        </circle>\n                        <path d=\"M50 18 A32 32 0 1 1 50 82 A32 32 0 1 1 50 18 M20 50 L80 50 M50 20 L50 80\" opacity=\"0.3\" stroke=\"white\" stroke-width=\"0.5\">\n                        </path>\n                        <circle cx=\"50\" cy=\"50\" fill=\"white\" r=\"4\">\n                        </circle>\n                        <g fill=\"white\">\n                            <circle cx=\"50\" cy=\"18\" r=\"2.5\">\n                            </circle>\n                            <circle cx=\"50\" cy=\"82\" r=\"2.5\">\n                            </circle>\n                            <circle cx=\"18\" cy=\"50\" r=\"2.5\">\n                            </circle>\n                            <circle cx=\"82\" cy=\"50\" r=\"2.5\">\n                            </circle>\n                            <circle cx=\"28\" cy=\"28\" r=\"2\">\n                            </circle>\n                            <circle cx=\"72\" cy=\"72\" r=\"2\">\n                            </circle>\n                            <circle cx=\"28\" cy=\"72\" r=\"2\">\n                            </circle>\n                            <circle cx=\"72\" cy=\"28\" r=\"2\">\n                            </circle>\n                        </g>\n                    </svg>\n                </div>\n            </div>\n            <h1 class=\"text-white text-[60px] font-black tracking-tight mb-2 leading-none\" data-kid=\"1-1-1-3\" data-name=\"company name headline\">\n                ITBEES Global Pvt. Ltd.\n            </h1>\n            <p class=\"text-white/80 text-lg font-medium tracking-[0.35em] uppercase\" data-kid=\"1-1-1-4\" data-name=\"company taglines text\">\n                Smart Cloud | BI Analytics | ERP Solutions\n            </p>\n            <div class=\"title-band\" data-kid=\"1-1-1-5\" data-name=\"title band container\">\n                <h2 class=\"text-[38px] font-black tracking-[0.2em] uppercase whitespace-nowrap\" data-kid=\"1-1-1-5-1\" data-name=\"certificate title text\">\n                    Certificate of Completion\n                </h2>\n            </div>\n        </div>\n        <!-- Background Graphics -->\n        <div class=\"chart-decoration left-8\" data-kid=\"1-1-2\" data-name=\"chart graphic left decoration\">\n            <svg class=\"text-blue-900\" data-kid=\"1-1-2-1\" data-name=\"chart graphic icon left\" fill=\"none\" height=\"300\" viewbox=\"0 0 240 300\" width=\"240\">\n                <rect fill=\"currentColor\" height=\"150\" rx=\"2\" width=\"20\" x=\"20\" y=\"100\">\n                </rect>\n                <rect fill=\"currentColor\" height=\"200\" rx=\"2\" width=\"20\" x=\"50\" y=\"50\">\n                </rect>\n                <rect fill=\"currentColor\" height=\"130\" rx=\"2\" width=\"20\" x=\"80\" y=\"120\">\n                </rect>\n                <rect fill=\"currentColor\" height=\"170\" rx=\"2\" width=\"20\" x=\"110\" y=\"80\">\n                </rect>\n                <path d=\"M20 200 L60 150 L100 180 L140 100\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"4\">\n                </path>\n            </svg>\n        </div>\n        <div class=\"chart-decoration right-8 text-right\" data-kid=\"1-1-3\" data-name=\"chart graphic right decoration\">\n            <svg class=\"text-blue-900\" data-kid=\"1-1-3-1\" data-name=\"chart graphic icon right\" fill=\"none\" height=\"300\" viewbox=\"0 0 240 300\" width=\"240\">\n                <circle cx=\"180\" cy=\"150\" r=\"60\" stroke=\"currentColor\" stroke-width=\"2\">\n                </circle>\n                <path d=\"M180 150 L180 90 A60 60 0 0 1 240 150 Z\" fill=\"currentColor\" opacity=\"0.5\">\n                </path>\n                <rect height=\"60\" rx=\"4\" stroke=\"currentColor\" stroke-width=\"2\" width=\"100\" x=\"20\" y=\"180\">\n                </rect>\n                <line stroke=\"currentColor\" stroke-width=\"2\" x1=\"30\" x2=\"90\" y1=\"195\" y2=\"195\">\n                </line>\n                <line stroke=\"currentColor\" stroke-width=\"2\" x1=\"30\" x2=\"70\" y1=\"210\" y2=\"210\">\n                </line>\n            </svg>\n        </div>\n        <!-- Center Globe Watermark -->\n        <div class=\"absolute top-[65%] left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-[0.03] pointer-events-none\" data-kid=\"1-1-4\" data-name=\"globe watermark container\">\n            <svg data-kid=\"1-1-4-1\" data-name=\"globe watermark icon\" fill=\"none\" height=\"400\" stroke=\"#001F5B\" stroke-width=\"1\" viewbox=\"0 0 24 24\" width=\"400\">\n                <circle cx=\"12\" cy=\"12\" r=\"10\">\n                </circle>\n                <line x1=\"2\" x2=\"22\" y1=\"12\" y2=\"12\">\n                </line>\n                <path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\">\n                </path>\n            </svg>\n        </div>\n        <!-- Main Content -->\n        <div class=\"flex-1 flex flex-col items-center pt-24 px-32 text-center relative z-10\" data-kid=\"1-1-5\" data-name=\"main body content container\">\n            <p class=\"text-xl font-bold text-slate-900 mb-2 font-['Inter']\" data-kid=\"1-1-5-1\" data-name=\"certification introduction text\">\n                This is to certify that\n            </p>\n            <div class=\"mb-10 w-full flex flex-col items-center\" data-kid=\"1-1-5-2\" data-name=\"recipient name field section\">\n                <div class=\"underlined-field\" data-kid=\"1-1-5-2-1\" data-name=\"name underline field\">\n                </div>\n                <p class=\"mt-8 text-xl text-slate-900 font-bold font-['Inter']\" data-kid=\"1-1-5-2-2\" data-name=\"certification details text\">\n                    has successfully completed the\n                    <span class=\"text-[#001F5B]\" data-kid=\"1-1-5-2-2-1\" data-name=\"training program label\">\n                        professional training program\n                    </span>\n                    in\n                </p>\n            </div>\n            <div class=\"mb-10 w-full flex flex-col items-center\" data-kid=\"1-1-5-3\" data-name=\"course name field section\">\n                <div class=\"underlined-field w-[750px]\" data-kid=\"1-1-5-3-1\" data-name=\"course name underline field\">\n                </div>\n                <p class=\"mt-8 text-2xl font-bold text-slate-900 font-['Inter'] whitespace-nowrap\" data-kid=\"1-1-5-3-2\" data-name=\"conducting body text\">\n                    conducted by\n                    <span class=\"text-[#001F5B]\" data-kid=\"1-1-5-3-2-1\" data-name=\"conducting organization name\">\n                        ITBEES Global Pvt. Ltd.\n                    </span>\n                </p>\n            </div>\n            <div class=\"max-w-5xl space-y-3 mt-6 pr-56\" data-kid=\"1-1-5-4\" data-name=\"training description paragraph section\">\n                <p class=\"text-base text-slate-700 leading-relaxed font-['Inter'] px-12 font-medium text-center\" data-kid=\"1-1-5-4-1\" data-name=\"curriculum description text\">\n                    The training was designed with an industry-oriented curriculum, covering practical applications, real-time scenarios, and hands-on exercises in Business Intelligence, Data Analytics and\n                </p>\n                <p class=\"text-base text-slate-700 leading-relaxed font-['Inter'] px-12 font-medium text-center\" data-kid=\"1-1-5-4-2\" data-name=\"skills demonstration text\">\n                    The participant has demonstrated\n                    <span class=\"text-[#001F5B] font-bold\" data-kid=\"1-1-5-4-2-1\" data-name=\"commitment proficiency highlight\">\n                        commitment, proficiency,\n                    </span>\n                    and\n                    <span class=\"text-[#001F5B] font-bold\" data-kid=\"1-1-5-4-2-2\" data-name=\"practical understanding highlight\">\n                        practical understanding\n                    </span>\n                    during the course tenure.\n                </p>\n            </div>\n        </div>\n        <!-- Bottom Row: Cards & Seal -->\n        <div class=\"px-16 pb-12 flex justify-between items-end relative z-20\" data-kid=\"1-1-6\" data-name=\"bottom info and seal row\">\n            <!-- Left: QR & Details -->\n            <div class=\"flex gap-6 items-stretch\" data-kid=\"1-1-6-1\" data-name=\"course metadata section\">\n                <!-- QR Code -->\n                <div class=\"bg-white p-2 rounded-xl border border-slate-200 card-shadow\" data-kid=\"1-1-6-1-1\" data-name=\"qr code image container\">\n                    <img alt=\"QR Code\" class=\"w-24 h-24\" data-kid=\"1-1-6-1-1-1\" data-name=\"qr code image\" decoding=\"async\" loading=\"lazy\" src=\"https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=ITBEES-VERIFY-12345\"/>\n                </div>\n                <!-- Course Details -->\n                <div class=\"bg-white p-4 rounded-xl border border-slate-200 card-shadow flex flex-col justify-center min-w-[240px]\" data-kid=\"1-1-6-1-2\" data-name=\"course details card\">\n                    <h3 class=\"text-[#001F5B] font-bold text-sm mb-2 border-b border-slate-100 pb-1\" data-kid=\"1-1-6-1-2-1\" data-name=\"course details header\">\n                        Course Details\n                    </h3>\n                    <ul class=\"text-[11px] text-slate-700 space-y-1 font-['Inter']\" data-kid=\"1-1-6-1-2-2\" data-name=\"course details list\">\n                        <li class=\"flex items-center gap-2\" data-kid=\"1-1-6-1-2-2-1\" data-name=\"duration list item\">\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[#001F5B]\" data-kid=\"1-1-6-1-2-2-1-1\" data-name=\"duration bullet icon\">\n                            </span>\n                            Course Duration: ________ Hours / Weeks\n                        </li>\n                        <li class=\"flex items-center gap-2\" data-kid=\"1-1-6-1-2-2-2\" data-name=\"mode list item\">\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[#001F5B]\" data-kid=\"1-1-6-1-2-2-2-1\" data-name=\"mode bullet icon\">\n                            </span>\n                            Mode: Live Practical Training\n                        </li>\n                        <li class=\"flex items-center gap-2\" data-kid=\"1-1-6-1-2-2-3\" data-name=\"date list item\">\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[#001F5B]\" data-kid=\"1-1-6-1-2-2-3-1\" data-name=\"date bullet icon\">\n                            </span>\n                            Completion Date: ____/____/____\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <!-- Right: Issued By & Seal -->\n            <div class=\"flex items-end gap-12 mr-24\" data-kid=\"1-1-6-2\" data-name=\"issued by section\">\n                <!-- Issued By -->\n                <div class=\"bg-white p-4 rounded-xl border border-slate-200 card-shadow text-center min-w-[200px]\" data-kid=\"1-1-6-2-1\" data-name=\"issuing organization card\">\n                    <h3 class=\"text-slate-500 font-bold text-xs uppercase tracking-wider mb-2\" data-kid=\"1-1-6-2-1-1\" data-name=\"issuing body header\">\n                        Issued By\n                    </h3>\n                    <p class=\"text-[#001F5B] font-bold text-sm\" data-kid=\"1-1-6-2-1-2\" data-name=\"issuing body name\">\n                        ITBEES Global Pvt. Ltd.\n                    </p>\n                    <p class=\"text-[9px] text-slate-500 mt-1\" data-kid=\"1-1-6-2-1-3\" data-name=\"issuing body tagline\">\n                        Smart Cloud | BI Analytics | ERP Solutions\n                    </p>\n                </div>\n            </div>\n            <!-- Seal (Overlapping Position) -->\n            <div class=\"seal-container scale-[1.2] -mr-8 -mb-4\" data-kid=\"1-1-6-3\" data-name=\"seal container\">\n                <!-- Ribbons -->\n                <div class=\"ribbon left-10 translate-y-3 rotate-[-12deg] bg-[#001F5B]\" data-kid=\"1-1-6-3-1\" data-name=\"ribbon left graphic\">\n                </div>\n                <div class=\"ribbon right-10 translate-y-3 rotate-[12deg] bg-[#001F5B]\" data-kid=\"1-1-6-3-2\" data-name=\"ribbon right graphic\">\n                </div>\n                <!-- Gold Seal -->\n                <div class=\"w-40 h-40 rounded-full bg-gradient-to-b from-[#E5B834] to-[#B8860B] p-1.5 shadow-2xl flex items-center justify-center relative border border-[#B8860B]\" data-kid=\"1-1-6-3-3\" data-name=\"gold seal base\">\n                    <div class=\"absolute inset-0 rounded-full border-[3px] border-[#001F5B]/15 border-dashed\" data-kid=\"1-1-6-3-3-1\" data-name=\"seal decorative border\">\n                    </div>\n                    <div class=\"w-full h-full rounded-full bg-[#D4AF37] border-4 border-double border-[#B8860B]/50 flex flex-col items-center justify-center p-1 text-center\" data-kid=\"1-1-6-3-3-2\" data-name=\"seal inner emblem\">\n                        <div class=\"absolute top-4 w-full px-2 flex items-center justify-center gap-1\" data-kid=\"1-1-6-3-3-2-1\" data-name=\"seal label container\">\n                            <span class=\"text-[9px] text-[#001F5B] font-black leading-none mt-0.5\" data-kid=\"1-1-6-3-3-2-1-1\" data-name=\"seal star left\">\n                                ★\n                            </span>\n                            <span class=\"text-[7px] font-black text-[#001F5B] uppercase tracking-tighter whitespace-nowrap\" data-kid=\"1-1-6-3-3-2-1-2\" data-name=\"seal label text\">\n                                CERTIFICATE OF COMPLETION\n                            </span>\n                            <span class=\"text-[9px] text-[#001F5B] font-black leading-none mt-0.5\" data-kid=\"1-1-6-3-3-2-1-3\" data-name=\"seal star right\">\n                                ★\n                            </span>\n                        </div>\n                        <div class=\"bg-[#001A4D] rounded-full p-2.5 mt-3 shadow-xl border border-white/10\" data-kid=\"1-1-6-3-3-2-2\" data-name=\"seal checkmark icon wrapper\">\n                            <svg class=\"w-8 h-8 text-[#D4AF37]\" data-kid=\"1-1-6-3-3-2-2-1\" data-name=\"seal checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\" viewbox=\"0 0 24 24\">\n                                <path d=\"M5 13l4 4L19 7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                </path>\n                            </svg>\n                        </div>\n                    </div>\n                </div>\n                <!-- Seal Label -->\n                <div class=\"absolute bottom-1 left-1/2 -translate-x-1/2 w-56 bg-[#001A4D] text-white py-2 px-1 text-center shadow-2xl border-b-2 border-[#D4AF37]\" data-kid=\"1-1-6-3-4\" data-name=\"seal bottom label container\">\n                    <div class=\"text-[10px] font-bold uppercase tracking-[0.1em]\" data-kid=\"1-1-6-3-4-1\" data-name=\"seal label title\">\n                        Industry-Oriented\n                    </div>\n                    <div class=\"text-[9px] uppercase tracking-widest opacity-90\" data-kid=\"1-1-6-3-4-2\" data-name=\"seal label description\">\n                        Corporate Level Training\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- Footer Band -->\n        <div class=\"bg-slate-50 border-t border-slate-200 px-16 py-4 flex justify-between items-end text-[13px] font-medium text-slate-700\" data-kid=\"1-1-7\" data-name=\"footer metadata bar\">\n            <div class=\"flex items-center gap-4 mb-2\" data-kid=\"1-1-7-1\" data-name=\"verification link container\">\n                <span data-kid=\"1-1-7-1-1\" data-name=\"verification label\">\n                    Verify at:\n                    <a class=\"text-[#001F5B] font-bold ml-1\" data-kid=\"1-1-7-1-1-1\" data-name=\"verification link\" href=\"https://www.itbeesglobal.com\">\n                        www.itbeesglobal.com\n                    </a>\n                </span>\n                <div class=\"h-6 w-[1px] bg-slate-300 mx-2\" data-kid=\"1-1-7-1-2\" data-name=\"footer divider line\">\n                </div>\n            </div>\n            <div class=\"flex gap-16 mr-16\" data-kid=\"1-1-7-2\" data-name=\"signature blocks container\">\n                <div class=\"flex flex-col items-center\" data-kid=\"1-1-7-2-1\" data-name=\"authorized signatory block\">\n                    <div class=\"w-48 border-b border-slate-400 mb-2\" data-kid=\"1-1-7-2-1-1\" data-name=\"signatory line\">\n                    </div>\n                    <span class=\"text-[12px] font-semibold text-slate-800\" data-kid=\"1-1-7-2-1-2\" data-name=\"signatory label\">\n                        Authorized Signatory\n                    </span>\n                </div>\n                <div class=\"flex flex-col items-center\" data-kid=\"1-1-7-2-2\" data-name=\"training head block\">\n                    <div class=\"w-48 border-b border-slate-400 mb-2\" data-kid=\"1-1-7-2-2-1\" data-name=\"training head line\">\n                    </div>\n                    <span class=\"text-[12px] font-semibold text-slate-800\" data-kid=\"1-1-7-2-2-2\" data-name=\"training head label\">\n                        Training Head\n                    </span>\n                </div>\n            </div>\n        </div>\n        <!-- Dark Navy Bottom Bar -->\n        <div class=\"bg-[#001F5B] text-white py-2 px-16 text-center text-[12px] font-medium tracking-wide\" data-kid=\"1-1-8\" data-name=\"bottom dark navy bar\">\n            Certificate ID: ITB/DA/________/2026\n            <span class=\"opacity-70 ml-2\" data-kid=\"1-1-8-1\" data-name=\"verification note text\">\n                (For verification & records)\n            </span>\n        </div>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    window.addEventListener('load', () => {\n    gsap.from('#certificate', {\n      duration: 1.2,\n      y: 50,\n      opacity: 0,\n      ease: \"power4.out\"\n    });\n    \n    gsap.from('.header-navy', {\n      duration: 1.5,\n      y: -50,\n      opacity: 0,\n      ease: \"power3.out\",\n      delay: 0.3\n    });\n\n    gsap.from('.seal-container', {\n      duration: 1,\n      scale: 0.5,\n      opacity: 0,\n      rotation: -20,\n      ease: \"back.out(1.7)\",\n      delay: 0.8\n    });\n  });\n</script>\n",
